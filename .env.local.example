# Copy this file to .env.local and fill in values for Live Mode.
# Demo Mode works with zero API keys — no file needed.

# ── Provider selection ──────────────────────────────────────────────────
# "anthropic" (default) or "ollama"
PROVIDER=anthropic

# ── Anthropic (default provider) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local, free) ────────────────────────────────────────────────
# PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
